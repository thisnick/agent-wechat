{
  "name": "@agent-wechat/deepseek-harness-extension",
  "version": "3.0.0-beta.1",
  "type": "module",
  "description": "agent-wechat WeChat channel for DeepSeek Harness (Cordis) hosts — native daemon bridge, per-thread agent routing, and WeChat tools",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/agent-wechat/agent-wechat",
    "directory": "packages/deepseek-harness-extension"
  },
  "exports": {
    ".": "./dist/index.js",
    "./client": "./client/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist/index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build": "esbuild index.ts --bundle --format=esm --platform=node --outfile=dist/index.js --external:ws",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types src/*.test.ts"
  },
  "dependencies": {
    "@agent-wechat/shared": "workspace:*",
    "@deepseek-ai/schemastery": "3.19.0",
    "ws": "8.22.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.1",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@types/node": "24.10.1",
    "esbuild": "0.27.2",
    "typescript": "5.9.3"
  }
}
