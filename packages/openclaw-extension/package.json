{
  "name": "@agent-wechat/agent-wechat",
  "version": "1.4.0-beta.2",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild index.ts --bundle --format=esm --platform=node --outfile=dist/index.js --external:openclaw --external:ws",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types src/*.test.ts"
  },
  "devDependencies": {
    "@agent-wechat/shared": "workspace:*",
    "@types/node": "^22",
    "esbuild": "^0.25.0",
    "openclaw": "2026.10.9",
    "typescript": "^5.4.5"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "channel": {
      "id": "agent-wechat",
      "label": "WeChat",
      "selectionLabel": "WeChat (微信)",
      "order": 80
    },
    "install": {
      "npmSpec": "@agent-wechat/agent-wechat"
    },
    "channelConfigs": {
      "agent-wechat": {
        "label": "WeChat",
        "description": "WeChat messaging through the standalone native daemon.",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "dmPolicy": {
              "type": "string",
              "enum": [
                "open",
                "allowlist",
                "disabled"
              ]
            },
            "allowFrom": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "groupPolicy": {
              "type": "string",
              "enum": [
                "open",
                "allowlist",
                "disabled"
              ]
            },
            "groupAllowFrom": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "groups": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "requireMention": {
                    "type": "boolean"
                  },
                  "groupPolicy": {
                    "type": "string",
                    "enum": [
                      "open",
                      "allowlist",
                      "disabled"
                    ]
                  },
                  "allowFrom": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "mediaMaxMb": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1024
            },
            "backend": {
              "type": "string",
              "enum": [
                "native"
              ]
            },
            "native": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "accountId",
                "token",
                "consumerStateDir"
              ],
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "managed",
                    "external"
                  ]
                },
                "accountId": {
                  "type": "string",
                  "minLength": 1
                },
                "endpoint": {
                  "type": "string"
                },
                "executable": {
                  "type": "string"
                },
                "serverConfig": {
                  "type": "string"
                },
                "dataDir": {
                  "type": "string"
                },
                "listen": {
                  "type": "string"
                },
                "token": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "source",
                        "provider",
                        "id"
                      ],
                      "properties": {
                        "source": {
                          "type": "string",
                          "enum": [
                            "env",
                            "file",
                            "exec",
                            "store"
                          ]
                        },
                        "provider": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                        },
                        "id": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  ]
                },
                "consumerStateDir": {
                  "type": "string"
                },
                "readPolicy": {
                  "type": "string",
                  "enum": [
                    "never",
                    "on_inbound",
                    "on_model_dispatch"
                  ]
                },
                "gatewayFacade": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "enabled"
                  ],
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "prefix": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "calls": {
              "type": "object",
              "additionalProperties": false,
              "description": "Independent voice and video permissions. Both default off; the current backend supports direct voice only.",
              "properties": {
                "voice": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {
                      "type": "boolean",
                      "default": false,
                      "description": "Enable direct voice calling. Disabled voice calls are ignored without answering or declining."
                    },
                    "inboundPolicy": {
                      "type": "string",
                      "enum": [
                        "disabled",
                        "allowlist"
                      ]
                    },
                    "inboundAllowFrom": {
                      "type": "array",
                      "maxItems": 128,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      }
                    },
                    "outboundPolicy": {
                      "type": "string",
                      "enum": [
                        "disabled",
                        "allowlist"
                      ]
                    },
                    "outboundAllowTo": {
                      "type": "array",
                      "maxItems": 128,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      }
                    },
                    "outboundToolAllowFrom": {
                      "type": "array",
                      "maxItems": 128,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      }
                    },
                    "agentId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "realtime": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "provider": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200,
                          "description": "Use openai. Other providers and continuous-output models fail preflight without fallback."
                        },
                        "model": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200,
                          "description": "Realtime speech model; omitted uses the selected provider's default."
                        },
                        "voice": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200,
                          "description": "Spoken voice; omitted uses the selected provider's default."
                        },
                        "instructions": {
                          "type": "string",
                          "maxLength": 4000,
                          "description": "Additional conversation guidance; does not grant tool or account-owner authority."
                        },
                        "providers": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "openai": {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "apiKey": {
                                  "description": "Optional OpenClaw SecretRef or API-key string. Omitted uses the selected agent's OpenAI auth profile or Gateway environment."
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "toolPolicy": {
                      "type": "string",
                      "enum": [
                        "none",
                        "safe-read-only"
                      ],
                      "default": "none"
                    },
                    "allowConsultSessionPersistence": {
                      "type": "boolean",
                      "default": false,
                      "description": "Required for safe-read-only consultation: OpenClaw creates a separate per-call agent session which can persist. This adapter does not store transcripts or recordings."
                    },
                    "consultation": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "model": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200,
                          "pattern": "^[^/]+/.+$",
                          "description": "Agent-consult provider/model override; omitted uses the selected agent's model."
                        },
                        "timeoutMs": {
                          "type": "integer",
                          "minimum": 1000,
                          "maximum": 120000,
                          "default": 30000
                        }
                      }
                    },
                    "maxDurationSeconds": {
                      "type": "integer",
                      "minimum": 30,
                      "maximum": 3600,
                      "default": 300
                    }
                  }
                },
                "video": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {
                      "type": "boolean",
                      "default": false,
                      "description": "Allow video independently of voice. Current video capability is unavailable; permission alone never answers a video call or routes it as voice."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thisnick/agent-wechat.git",
    "directory": "packages/openclaw-extension"
  },
  "dependencies": {
    "ws": "8.22.0"
  }
}
