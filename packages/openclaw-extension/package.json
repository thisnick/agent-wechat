{
  "name": "@agent-wechat/agent-wechat",
  "version": "1.3.0-beta.0",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild index.ts --bundle --format=esm --platform=node --outfile=dist/index.js --external:openclaw",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types src/*.test.ts"
  },
  "devDependencies": {
    "@agent-wechat/shared": "workspace:*",
    "@types/node": "^22",
    "esbuild": "^0.25.0",
    "openclaw": "2026.10.7",
    "typescript": "^5.4.5"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "channel": {
      "id": "agent-wechat",
      "label": "WeChat",
      "selectionLabel": "WeChat (微信)",
      "order": 80
    },
    "install": {
      "npmSpec": "@agent-wechat/agent-wechat"
    },
    "channelConfigs": {
      "agent-wechat": {
        "label": "WeChat",
        "description": "WeChat messaging through the standalone native daemon.",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "dmPolicy": {
              "type": "string",
              "enum": [
                "open",
                "allowlist",
                "disabled"
              ]
            },
            "allowFrom": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "groupPolicy": {
              "type": "string",
              "enum": [
                "open",
                "allowlist",
                "disabled"
              ]
            },
            "groupAllowFrom": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "groups": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "requireMention": {
                    "type": "boolean"
                  },
                  "groupPolicy": {
                    "type": "string",
                    "enum": [
                      "open",
                      "allowlist",
                      "disabled"
                    ]
                  },
                  "allowFrom": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "mediaMaxMb": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1024
            },
            "backend": {
              "type": "string",
              "enum": [
                "native"
              ]
            },
            "native": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "accountId",
                "token",
                "consumerStateDir"
              ],
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "managed",
                    "external"
                  ]
                },
                "accountId": {
                  "type": "string",
                  "minLength": 1
                },
                "endpoint": {
                  "type": "string"
                },
                "executable": {
                  "type": "string"
                },
                "serverConfig": {
                  "type": "string"
                },
                "dataDir": {
                  "type": "string"
                },
                "listen": {
                  "type": "string"
                },
                "token": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "source",
                        "provider",
                        "id"
                      ],
                      "properties": {
                        "source": {
                          "type": "string",
                          "enum": [
                            "env",
                            "file",
                            "exec",
                            "store"
                          ]
                        },
                        "provider": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                        },
                        "id": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  ]
                },
                "consumerStateDir": {
                  "type": "string"
                },
                "readPolicy": {
                  "type": "string",
                  "enum": [
                    "never",
                    "on_inbound",
                    "on_model_dispatch"
                  ]
                },
                "gatewayFacade": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "enabled"
                  ],
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "prefix": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thisnick/agent-wechat.git",
    "directory": "packages/openclaw-extension"
  }
}
