{
  "name": "@agent-wechat/agent-wechat",
  "version": "2.3.0",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild index.ts --bundle --format=esm --platform=node --outfile=dist/index.js --external:openclaw --external:ws",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types src/*.test.ts"
  },
  "devDependencies": {
    "@agent-wechat/shared": "workspace:*",
    "@types/node": "^22",
    "esbuild": "^0.25.0",
    "openclaw": "2026.11.2",
    "typescript": "^5.4.5"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "channel": {
      "id": "agent-wechat",
      "label": "WeChat",
      "selectionLabel": "WeChat (微信)",
      "order": 80
    },
    "install": {
      "npmSpec": "@agent-wechat/agent-wechat"
    },
    "channelConfigs": {
      "agent-wechat": {
        "label": "WeChat",
        "description": "WeChat messaging through the standalone native daemon.",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "dmPolicy": {
              "type": "string",
              "enum": [
                "open",
                "allowlist",
                "disabled"
              ]
            },
            "allowFrom": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "groupPolicy": {
              "type": "string",
              "enum": [
                "open",
                "allowlist",
                "disabled"
              ]
            },
            "groupAllowFrom": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "groups": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "requireMention": {
                    "type": "boolean"
                  },
                  "groupPolicy": {
                    "type": "string",
                    "enum": [
                      "open",
                      "allowlist",
                      "disabled"
                    ]
                  },
                  "allowFrom": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "mediaMaxMb": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1024
            },
            "backend": {
              "type": "string",
              "enum": [
                "native"
              ]
            },
            "native": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "accountId",
                "token",
                "consumerStateDir"
              ],
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "managed",
                    "external"
                  ]
                },
                "accountId": {
                  "type": "string",
                  "minLength": 1
                },
                "endpoint": {
                  "type": "string"
                },
                "executable": {
                  "type": "string"
                },
                "serverConfig": {
                  "type": "string"
                },
                "dataDir": {
                  "type": "string"
                },
                "listen": {
                  "type": "string"
                },
                "token": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "source",
                        "provider",
                        "id"
                      ],
                      "properties": {
                        "source": {
                          "type": "string",
                          "enum": [
                            "env",
                            "file",
                            "exec",
                            "store"
                          ]
                        },
                        "provider": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                        },
                        "id": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  ]
                },
                "consumerStateDir": {
                  "type": "string"
                },
                "readPolicy": {
                  "type": "string",
                  "enum": [
                    "never",
                    "on_inbound",
                    "on_model_dispatch"
                  ]
                },
                "gatewayFacade": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "enabled"
                  ],
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "prefix": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "calls": {
              "type": "object",
              "additionalProperties": false,
              "description": "Independent voice and video permissions. Voice includes direct calls and separately configured conferences; both default off.",
              "properties": {
                "voice": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {
                      "type": "boolean",
                      "default": false,
                      "description": "Enable voice calling. Conferences require an exact group rule or an explicit wildcard group rule. Disabled voice calls are ignored without answering or declining."
                    },
                    "mode": {
                      "type": "string",
                      "enum": [
                        "bidi",
                        "agent"
                      ],
                      "default": "bidi",
                      "description": "bidi uses a realtime voice model (including Live); agent transcribes speech, runs the configured OpenClaw agent and speaks through OpenClaw TTS. Applies to direct calls and conferences."
                    },
                    "transcription": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "provider": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200,
                          "default": "openai",
                          "description": "Registered realtime transcription provider for agent mode."
                        },
                        "model": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        },
                        "language": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        },
                        "apiKey": {
                          "description": "Optional OpenClaw SecretRef or API-key string for the transcription provider. Omitted uses provider configuration."
                        }
                      }
                    },
                    "inboundPolicy": {
                      "type": "string",
                      "enum": [
                        "disabled",
                        "allowlist"
                      ]
                    },
                    "inboundAllowFrom": {
                      "type": "array",
                      "maxItems": 128,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "description": "Direct-call caller IDs; an explicit '*' accepts any incoming caller. Admission does not grant owner consultation."
                    },
                    "outboundPolicy": {
                      "type": "string",
                      "enum": [
                        "disabled",
                        "allowlist"
                      ]
                    },
                    "outboundAllowTo": {
                      "type": "array",
                      "maxItems": 128,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      }
                    },
                    "outboundToolAllowFrom": {
                      "type": "array",
                      "maxItems": 128,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      }
                    },
                    "conferences": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "groups": {
                          "type": "object",
                          "maxProperties": 128,
                          "propertyNames": {
                            "type": "string",
                            "pattern": "^(?:\\*|.+@chatroom)$",
                            "maxLength": 200
                          },
                          "description": "Exact group IDs or '*'. An exact rule overrides the wildcard, including autoJoin=false. Wildcard auto-join requires autoJoinAllowFrom; use ['*'] to accept any inviter.",
                          "allOf": [
                            {
                              "if": {
                                "required": [
                                  "*"
                                ],
                                "properties": {
                                  "*": {
                                    "required": [
                                      "autoJoin"
                                    ],
                                    "properties": {
                                      "autoJoin": {
                                        "const": true
                                      }
                                    }
                                  }
                                }
                              },
                              "then": {
                                "properties": {
                                  "*": {
                                    "required": [
                                      "autoJoinAllowFrom"
                                    ]
                                  }
                                }
                              }
                            }
                          ],
                          "additionalProperties": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "autoJoin": {
                                "type": "boolean",
                                "default": false,
                                "description": "Join current authenticated invitations matching this group rule after voice preflight. No configured groups means no conference automation."
                              },
                              "autoJoinAllowFrom": {
                                "type": "array",
                                "maxItems": 128,
                                "items": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 200
                                },
                                "description": "Conference inviter IDs; '*' accepts any inviter and an empty list disables auto-join. Required for wildcard-group auto-join. An exact group may omit this field to accept any inviter. The current inviter is rechecked before joining."
                              },
                              "toolPolicy": {
                                "type": "string",
                                "enum": [
                                  "none",
                                  "safe-read-only",
                                  "owner"
                                ],
                                "default": "safe-read-only",
                                "description": "Conference consultation authority. Owner requires voice.toolPolicy=owner and an exact agent-wechat:GROUP_ID grant in commands.ownerAllowFrom. It trusts the whole group without attributing speech to a person; otherwise consultation stays read-only."
                              },
                              "ownerInviterToolPolicy": {
                                "type": "string",
                                "enum": [
                                  "none",
                                  "safe-read-only",
                                  "owner"
                                ],
                                "description": "Optional policy for calls whose authenticated inviter exactly matches an agent-wechat:CONTACT_ID owner grant. Otherwise toolPolicy applies. Owner also requires voice.toolPolicy=owner and an exact group owner grant. Applies to the whole call, including later participants; permissions can decrease but cannot increase during a call."
                              },
                              "sessionKey": {
                                "type": "string",
                                "pattern": "^agent:[a-z0-9][a-z0-9_-]{0,63}:[^:\\s][^\\s]*$",
                                "maxLength": 1024,
                                "description": "Optional consultation parent session of this voice agent for this group. Default sessions are isolated by account, group and authority."
                              }
                            }
                          }
                        }
                      }
                    },
                    "agentId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "realtime": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "provider": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200,
                          "description": "Use openai. Other providers fail preflight without fallback."
                        },
                        "model": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200,
                          "description": "Speech model, such as gpt-realtime-2.1 or the continuous gpt-live-1-codex; omitted uses the selected provider's default."
                        },
                        "voice": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200,
                          "description": "Spoken voice; omitted uses the selected provider's default."
                        },
                        "instructions": {
                          "type": "string",
                          "maxLength": 4000,
                          "description": "Additional conversation guidance; does not grant tool or account-owner authority."
                        },
                        "agentContext": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "enabled": {
                              "type": "boolean",
                              "default": false,
                              "description": "Use OpenClaw's shared voice context to send bounded IDENTITY.md, USER.md and SOUL.md excerpts for direct calls and conferences. Configured agent identity is used independently; normal agent/TTS turns already receive host context."
                            }
                          }
                        },
                        "recentContext": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "enabled": {
                              "type": "boolean",
                              "default": false,
                              "description": "When a call starts, send the Realtime provider the summaries of the last few calls with this contact and the latest messages of your WeChat chat with them, so the voice model knows what you last talked about."
                            },
                            "maxMessages": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 50,
                              "default": 10,
                              "description": "How many of the latest chat messages to include."
                            }
                          }
                        },
                        "consultPolicy": {
                          "type": "string",
                          "enum": [
                            "auto",
                            "substantive",
                            "always"
                          ],
                          "default": "auto",
                          "description": "Guide when the voice model consults. Always can use a final caller utterance as the consultation question when the voice model does not consult. GPT-Live models do not support always."
                        },
                        "consultThinkingLevel": {
                          "type": "string",
                          "enum": [
                            "off",
                            "minimal",
                            "low",
                            "medium",
                            "high",
                            "xhigh",
                            "adaptive",
                            "max",
                            "ultra"
                          ],
                          "description": "Thinking level for the regular OpenClaw consultation run."
                        },
                        "consultFastMode": {
                          "type": "boolean",
                          "description": "Set fast mode for the regular OpenClaw consultation run when its model supports it."
                        },
                        "providers": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "openai": {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "apiKey": {
                                  "description": "Optional OpenClaw SecretRef or API-key string. Omitted uses the selected agent's OpenAI auth profile or Gateway environment."
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "toolPolicy": {
                      "type": "string",
                      "enum": [
                        "none",
                        "safe-read-only",
                        "owner"
                      ],
                      "description": "Owner uses the normal agent tool policy only for an exact agent-wechat entry in commands.ownerAllowFrom matching the connected voice peer. Other admitted peers get read-only consultation. Defaults to safe-read-only with session persistence, otherwise none."
                    },
                    "allowConsultSessionPersistence": {
                      "type": "boolean",
                      "default": false,
                      "description": "Required for consultation. OpenClaw creates separate agent sessions for calls which can persist. This adapter stores no recordings; with consultation.summary it keeps the last few call summaries for each contact."
                    },
                    "consultation": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "timeoutMs": {
                          "type": "integer",
                          "minimum": 1000,
                          "maximum": 120000,
                          "default": 30000
                        },
                        "inboundSessionKey": {
                          "type": "string",
                          "pattern": "^agent:[a-z0-9][a-z0-9_-]{0,63}:[^:\\s][^\\s]*$",
                          "maxLength": 1024,
                          "description": "Optional existing session of the selected agent to fork into a call's session when that session is first created by an admitted incoming call."
                        },
                        "summary": {
                          "type": "boolean",
                          "default": true,
                          "description": "After an answered call, give the call's transcript to the agent in the call's session and keep its short summary. The summary is also left as a note in your WeChat chat with the caller, and calls placed with the wechat_call tool report it to the session that placed them."
                        },
                        "recentMessages": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 50,
                          "default": 10,
                          "description": "How many of the latest messages of your WeChat chat with the caller the call's first consultation gets as context; 0 turns this off."
                        }
                      }
                    },
                    "sessionScope": {
                      "type": "string",
                      "enum": [
                        "per-contact",
                        "per-call"
                      ],
                      "default": "per-contact",
                      "description": "per-contact keeps one session for each contact, so the agent remembers earlier calls with them; per-call starts every call in a new session."
                    },
                    "maxDurationSeconds": {
                      "type": "integer",
                      "minimum": 30,
                      "maximum": 3600,
                      "default": 3600
                    }
                  }
                },
                "video": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {
                      "type": "boolean",
                      "default": false,
                      "description": "Allow video independently of voice. Current video capability is unavailable; permission alone never answers a video call or routes it as voice."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thisnick/agent-wechat.git",
    "directory": "packages/openclaw-extension"
  },
  "dependencies": {
    "ws": "8.22.0"
  }
}
